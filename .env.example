# ============================================================
# SciTech Ear — Backend · variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env real.
# ============================================================

# Hugging Face (necessário para pyannote)
HF_TOKEN=

# Armazenamento local do runtime (dev/teste). Não versionar.
STORAGE_ROOT=./storage

# Persistência do estado dos jobs (job_repository.py). Vazio (default) usa
# SQLite em "<STORAGE_ROOT>/jobs.db" — zero infraestrutura extra, schema
# criado automaticamente na primeira execução. Defina para apontar a outro
# arquivo, ou (futuro) outro banco via URL do SQLAlchemy (ex.: postgresql://
# usuario:senha@host/banco), sem mudar código.
DATABASE_URL=

# Worker dedicado (app/worker.py) — consome a fila de jobs num processo
# separado da API. Intervalo de polling quando a fila está vazia (segundos).
WORKER_POLL_INTERVAL_SECONDS=2.0
# Proteção contra "job veneno": quantas vezes um job pode ser encontrado
# órfão (deixado por uma instância do worker que morreu no meio do
# processamento) antes de parar de reenfileirar e ir direto para error.
WORKER_MAX_ATTEMPTS_BEFORE_ERROR=3

# WhisperX (transcrição)
WHISPERX_MODEL=turbo
WHISPERX_LANGUAGE=pt
WHISPERX_BATCH_SIZE=16

# Diarização (pyannote)
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# Limites configuráveis (substituem os 4/7 fixos do legado). Usados quando o
# job não pede um número exato de falantes; expected_speaker_count vira
# max_speakers como pista.
DIARIZATION_MIN_SPEAKERS=1
DIARIZATION_MAX_SPEAKERS=10

# Biometria de voz (SpeechBrain ECAPA)
VOICE_MODEL=speechbrain/spkrec-ecapa-voxceleb
# 0.75: recalibrado após incidente de falso positivo (participante nunca
# cadastrado identificado como outra pessoa) com 0.30. Calibrado com
# embeddings ECAPA reais de TTS sintético — piso de match genuíno=0.9157,
# teto de impostor não-outlier=0.6214 (ver docs/PENDENCIAS.md e
# tests/fixtures/voice_identification_real_embeddings.json). PROVISÓRIO:
# pendente de revalidação com gravações humanas reais antes de produção.
VOICE_IDENTIFICATION_THRESHOLD=0.75
VOICE_MIN_MARGIN=0.05
VOICE_OUTLIER_THRESHOLD=0.45

# LLM (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b

# Flags
# Desliga a ETAPA inteira de perguntas implícitas (extract_implicit_questions
# + sumarização, que só existe como insumo dela) — não é o refinador abaixo.
# Temporário: isola o comportamento enquanto a qualidade da extração
# implícita é validada separadamente (ver docs/PENDENCIAS.md).
ENABLE_IMPLICIT_QUESTIONS=false
ENABLE_IMPLICIT_REFINEMENT=false
DEMO_MODE=false

# Autenticação (item 3 da preparação para produção). Obrigatório em
# produção — gerar com `openssl rand -hex 32`. Sem valor, auth_service
# recusa emitir/validar qualquer token (RuntimeError explícito, não um
# fallback inseguro).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Rate limiting de /auth/login (por e-mail) e /auth/register (por IP) —
# defesa mínima contra força bruta, sem infraestrutura nova (mesmo SQLite).
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOGIN_LOCKOUT_MINUTES=15
AUTH_REGISTER_MAX_ATTEMPTS=10
AUTH_REGISTER_WINDOW_MINUTES=60
