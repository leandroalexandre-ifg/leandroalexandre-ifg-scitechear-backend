# ============================================================
# SciTech Ear — Backend · variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env real.
# ============================================================

# Hugging Face (necessário para pyannote)
HF_TOKEN=

# Armazenamento local do runtime (dev/teste). Não versionar.
STORAGE_ROOT=./storage

# WhisperX (transcrição)
WHISPERX_MODEL=turbo
WHISPERX_LANGUAGE=pt
WHISPERX_BATCH_SIZE=16

# Diarização (pyannote)
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

# Biometria de voz (SpeechBrain ECAPA)
VOICE_MODEL=speechbrain/spkrec-ecapa-voxceleb
VOICE_IDENTIFICATION_THRESHOLD=0.30
VOICE_MIN_MARGIN=0.05
VOICE_OUTLIER_THRESHOLD=0.45

# LLM (Ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b

# Flags
ENABLE_IMPLICIT_REFINEMENT=false
DEMO_MODE=false
